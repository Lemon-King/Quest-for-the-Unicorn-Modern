<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Shared by every project in Unicorn.slnx: x64 output under bin\, static CRT, the game's C conventions -->
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\bin\obj\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>

  <!-- Release links with whole-program optimisation, which incremental linking would only warn about -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>HC;WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>

  <!-- Debug programs are signed with the self-signed certificate that debug-cert.ps1 makes and names in
       DebugSigning.user.props. Without that file, as on CI, they build unsigned. The linker sees a signed
       program as changed, so each relink of one is a full link. -->
  <Import Project="$(MSBuildThisFileDirectory)DebugSigning.user.props"
          Condition="exists('$(MSBuildThisFileDirectory)DebugSigning.user.props')" />

  <Target Name="SignDebugBuild" AfterTargets="Build"
          Condition="'$(Configuration)'=='Debug' and '$(ConfigurationType)'=='Application' and '$(DebugSigningThumbprint)'!=''"
          Inputs="$(TargetPath)" Outputs="$(IntDir)$(TargetName).signed">
    <Exec Command="&quot;$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\signtool.exe&quot; sign /q /fd sha256 /sha1 $(DebugSigningThumbprint) &quot;$(TargetPath)&quot;" />
    <Touch Files="$(IntDir)$(TargetName).signed" AlwaysCreate="true" />
    <Message Importance="high" Text="$(TargetFileName) signed with the local debug certificate" />
  </Target>
</Project>
